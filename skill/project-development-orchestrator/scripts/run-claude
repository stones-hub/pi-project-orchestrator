#!/usr/bin/env node
"use strict";

/**
 * Thin CLI wrapper around the real `claude` binary: builds the real,
 * locally-verified argv shape (see references/claude-code.md), spawns it,
 * streams raw stdout/stderr to evidence files, and prints a small summary.
 * Not a state machine or security platform: no auto-fallback, no retry, no
 * commit/push/deploy, no credential handling.
 */

const { acquireWorkspaceWriteLock, canonicalizeWorkspace } = require("./workspace-write-lock");
const { spawnWithEvidence, captureOverflowParseError } = require("./spawn-with-evidence");

const MODES = new Set(["investigate", "code", "review"]);

class UsageError extends Error {}

function parseArgs(argv) {
  const opts = {
    mode: null,
    prompt: null,
    model: null,
    evidenceFile: null,
    resume: null,
    workspace: null,
    command: "claude",
  };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    switch (arg) {
      case "--mode":
        opts.mode = argv[++i];
        break;
      case "--prompt":
        opts.prompt = argv[++i];
        break;
      case "--model":
        opts.model = argv[++i];
        break;
      case "--evidence-file":
        opts.evidenceFile = argv[++i];
        break;
      case "--resume":
        opts.resume = argv[++i];
        break;
      case "--workspace":
        opts.workspace = argv[++i];
        break;
      case "--command":
        // Explicit caller-trusted override; not automatic discovery.
        opts.command = argv[++i];
        break;
      case "--argv-prefix":
        throw new UsageError("--argv-prefix is not accepted; use an executable --command shim for tests");
      default:
        throw new UsageError(`unknown argument '${arg}'`);
    }
  }
  return opts;
}

function validate(opts) {
  if (!opts.mode || !MODES.has(opts.mode)) {
    throw new UsageError(`--mode must be one of investigate|code|review, got '${opts.mode}'`);
  }
  if (!opts.prompt) {
    throw new UsageError("--prompt is required");
  }
  if (!opts.model) {
    throw new UsageError("--model is required and must be non-empty");
  }
  if (!opts.evidenceFile) {
    throw new UsageError("--evidence-file is required");
  }
  if (opts.mode === "review" && opts.resume) {
    throw new UsageError("--resume is not allowed with --mode review; independent review must start a fresh session");
  }
}

function buildArgv(opts) {
  const readOnly = opts.mode === "investigate" || opts.mode === "review";
  const argv = ["-p", opts.prompt];
  if (readOnly) {
    argv.push(
      "--permission-mode",
      "plan",
      "--permission-prompts",
      "none",
      "--tools",
      "Read,Glob,Grep",
      "--disallowedTools",
      "mcp__*",
      "--strict-mcp-config",
    );
  } else {
    argv.push(
      "--permission-mode",
      "acceptEdits",
      "--permission-prompts",
      "none",
      "--allowedTools",
      "Read,Write,Edit,Bash,Glob,Grep",
    );
  }
  if (opts.resume) {
    argv.push("--resume", opts.resume);
  }
  argv.push("--output-format", "json", "--model", opts.model);
  return argv;
}

function hasModelEvidence(parsed) {
  return Boolean(parsed && parsed.modelUsage && typeof parsed.modelUsage === "object" && Object.keys(parsed.modelUsage).length > 0);
}

function extractReportedModel(parsed) {
  if (!hasModelEvidence(parsed)) return null;
  const keys = Object.keys(parsed.modelUsage);
  const first = parsed.modelUsage[keys[0]];
  if (first && typeof first === "object" && typeof first.canonicalModel === "string") {
    return first.canonicalModel;
  }
  return keys[0];
}

function isTerminalResult(parsed) {
  return Boolean(parsed) && typeof parsed.is_error === "boolean" && typeof parsed.result === "string";
}

function parseClaudeOutput(stdout) {
  let parsed;
  try {
    parsed = JSON.parse(stdout);
  } catch {
    return { ok: false, parseError: "stdout is not valid JSON" };
  }
  if (!parsed || typeof parsed.session_id !== "string" || parsed.session_id.length === 0) {
    return { ok: false, parseError: "response JSON is missing session_id" };
  }
  if (!isTerminalResult(parsed)) {
    return { ok: false, parseError: "response JSON is missing a terminal result/is_error shape" };
  }
  return {
    ok: true,
    sessionId: parsed.session_id,
    model: extractReportedModel(parsed),
    result: parsed.result,
    isError: parsed.is_error === true,
    usage: parsed.usage ?? null,
  };
}

function writeSummary(payload) {
  process.stdout.write(JSON.stringify(payload) + "\n");
}

async function main(argv) {
  let opts;
  try {
    opts = parseArgs(argv);
    validate(opts);
  } catch (err) {
    if (err instanceof UsageError) {
      writeSummary({ ok: false, status: "blocked", reason: err.message });
      return 2;
    }
    throw err;
  }

  let cwd;
  try {
    cwd = canonicalizeWorkspace(opts.workspace ?? process.cwd());
  } catch (err) {
    writeSummary({ ok: false, status: "blocked", reason: `workspace cannot be resolved: ${String(err.message ?? err)}` });
    return 2;
  }

  let writeLock = null;
  if (opts.mode === "code") {
    try {
      writeLock = acquireWorkspaceWriteLock(cwd, "claude");
    } catch (err) {
      writeSummary({ ok: false, status: "blocked", reason: `workspace write lock failed: ${String(err.message ?? err)}` });
      return 2;
    }
    if (!writeLock.ok) {
      writeSummary({ ok: false, status: "blocked", reason: writeLock.reason });
      return 2;
    }
  }

  const spawnArgv = buildArgv(opts);
  let result;
  try {
    result = await spawnWithEvidence({
      command: opts.command,
      argv: spawnArgv,
      cwd,
      evidenceFile: opts.evidenceFile,
    });
  } finally {
    writeLock?.release();
  }

  if (result.setupFailed) {
    writeSummary({
      ok: false,
      status: "failure",
      exitCode: null,
      sessionId: null,
      model: null,
      usage: null,
      result: null,
      isError: null,
      parseError: String(result.error?.message ?? result.error ?? "evidence setup failed"),
      stdoutEvidenceFile: result.stdoutEvidenceFile,
      stderrEvidenceFile: result.stderrEvidenceFile,
    });
    return 1;
  }

  if (result.startFailed) {
    writeSummary({
      ok: false,
      status: "executor_unavailable",
      reason: String(result.error?.message ?? result.error ?? "executor failed to start"),
      stdoutEvidenceFile: result.stdoutEvidenceFile,
      stderrEvidenceFile: result.stderrEvidenceFile,
    });
    return 3;
  }

  if (result.error && !result.startFailed) {
    // Stream write failure after a started process: treat as failure, keep evidence.
    writeSummary({
      ok: false,
      status: "failure",
      exitCode: result.status,
      sessionId: null,
      model: null,
      usage: null,
      result: null,
      isError: null,
      parseError: String(result.error.message ?? result.error),
      stdoutEvidenceFile: result.stdoutEvidenceFile,
      stderrEvidenceFile: result.stderrEvidenceFile,
    });
    return 1;
  }

  if (result.captureTruncated) {
    writeSummary({
      ok: false,
      status: "failure",
      exitCode: result.status,
      sessionId: null,
      model: null,
      usage: null,
      result: null,
      isError: null,
      parseError: captureOverflowParseError(result.captureLimit),
      stdoutEvidenceFile: result.stdoutEvidenceFile,
      stderrEvidenceFile: result.stderrEvidenceFile,
    });
    return 1;
  }

  const parsed = parseClaudeOutput(result.stdout ?? "");
  const succeeded = parsed.ok && parsed.isError !== true && result.status === 0 && !result.signal;

  writeSummary({
    ok: succeeded,
    status: succeeded ? "success" : "failure",
    exitCode: result.status,
    sessionId: parsed.sessionId ?? null,
    model: parsed.model ?? null,
    usage: parsed.usage ?? null,
    result: parsed.result ?? null,
    isError: parsed.ok ? parsed.isError : null,
    parseError: parsed.parseError ?? null,
    stdoutEvidenceFile: result.stdoutEvidenceFile,
    stderrEvidenceFile: result.stderrEvidenceFile,
  });
  return succeeded ? 0 : 1;
}

if (require.main === module) {
  main(process.argv.slice(2)).then((code) => process.exit(code));
}

module.exports = { main, parseArgs, validate, buildArgv, parseClaudeOutput, extractReportedModel, hasModelEvidence, UsageError };
